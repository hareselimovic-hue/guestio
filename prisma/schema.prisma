generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth required tables ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // "APARTMENT" | "HOTEL" — chosen at signup; default kind for new properties
  accountType   String    @default("APARTMENT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  properties       Property[]
  ownedWorkspace   Workspace?        @relation("WorkspaceOwner")
  workspaceMember  WorkspaceMember[]
  subscription     Subscription?
  payments         Payment[]
  invoices         Invoice[]
  tasks            Task[]            @relation("TaskAuthor")
  taskComments     TaskComment[]     @relation("TaskCommentAuthor")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Guestio models ───────────────────────────────────────────────────────────

model Property {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String?
  workspace    Workspace?  @relation(fields: [workspaceId], references: [id])
  name         String
  internalName String?
  slug         String      @unique
  coverImage   String?
  address      String?
  ownerName    String?
  ownerAddress String?
  ownerEmail   String?
  ownerPhone   String?
  bankAccount  String?
  rentlioPropertyId Int?     @unique
  // Per-property switch; only applies when the workspace has guest registration enabled
  guestRegistrationEnabled Boolean @default(false)
  // "APARTMENT" | "HOTEL" — hotels get rooms, reception requests, services, announcements, feedback
  kind              String   @default("APARTMENT")
  // Hotel: Google review link shown to guests as a "Rate us on Google" card
  reviewUrl         String?
  // Hotel: where guest requests are emailed (empty = account / registration recipients)
  receptionEmail    String?
  previewViewCount  Int      @default(0)
  chatCount         Int      @default(0)
  sections     Section[]
  guests       GuestLink[]
  registrations GuestRegistration[]
  tasks        Task[]
  hotelServices  HotelService[]
  guestRequests  GuestRequest[]
  announcements  Announcement[]
  feedback       GuestFeedback[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Section {
  id           String               @id @default(cuid())
  propertyId   String
  property     Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type         SectionType
  title        String
  content      Json
  order        Int                  @default(0)
  isVisible    Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations SectionTranslation[]
  roomOverrides RoomSectionOverride[]
}

// Hotel room: a section that differs from the hotel guide (everything else follows the hotel)
model RoomSectionOverride {
  id           String    @id @default(cuid())
  guestLinkId  String
  guestLink    GuestLink @relation(fields: [guestLinkId], references: [id], onDelete: Cascade)
  sectionId    String
  section      Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  content      Json
  translations Json?     // { DE: {...}, TR: {...}, IT: {...} }
  updatedAt    DateTime  @updatedAt

  @@unique([guestLinkId, sectionId])
}

model SectionTranslation {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  language  String
  content   Json
  updatedAt DateTime @updatedAt

  @@unique([sectionId, language])
}

enum SectionType {
  WELCOME
  WIFI
  CHECKIN
  HOUSE_RULES
  LOCATION
  LOCAL_RECS
  CONTACT
  PARKING
  CUSTOM
  AI_CONTEXT
}

model Workspace {
  id                 String            @id @default(cuid())
  name               String
  ownerId            String            @unique
  owner              User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members            WorkspaceMember[]
  invites            WorkspaceInvite[]
  properties         Property[]
  tasks              Task[]
  rentlioApiKey      String?
  rentlioConnectedAt DateTime?
  // Unused since guest registration is opt-in per property; kept so db push doesn't drop the column
  guestRegistrationEnabled Boolean     @default(false)
  // Who gets guest registration emails; empty = workspace owner
  registrationEmails String[]          @default([])
  createdAt          DateTime          @default(now())
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model WhitelistEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  validUntil        DateTime
  expiryEmailSentAt DateTime? // legacy, unused
  // validUntil value the expiry notice was sent for — resets naturally on renewal
  expiryNotice5dFor    DateTime?
  expiryNoticeTodayFor DateTime?
  // One-time "30 days free" win-back offer, 5 days after expiry — never offered twice
  winbackOfferSentAt DateTime?
  winbackToken       String?   // random 192-bit; indexed below (not @unique, to keep db push non-interactive)
  winbackAcceptedAt  DateTime?
  billingName       String?
  billingAddress    String?
  billingCity       String?
  billingPostcode   String?
  billingIdBroj     String?   // company ID (JIB/IDB), optional
  billingCountry    String    @default("BA")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([winbackToken])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantTransactionId String        @unique
  bankartUuid           String?
  propertyCount         Int
  amount                Float
  currency              String        @default("BAM")
  status                PaymentStatus @default(PENDING)
  // "CARD" (Bankart) | "BANK_TRANSFER" (virman; merchantTransactionId is the poziv na broj)
  method                String        @default("CARD")
  // Bank transfer: validUntil before the 7-day grace, so the paid month isn't shortened by it
  previousValidUntil    DateTime?
  invoice               Invoice?
  createdAt             DateTime      @default(now())
  paidAt                DateTime?
}

model Invoice {
  id              String   @id @default(cuid())
  number          String   @unique // SS-2026-0001
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId       String   @unique
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  method          String   // CARD | BANK_TRANSFER
  amount          Float
  currency        String   @default("BAM")
  propertyCount   Int
  billingName     String?
  billingAddress  String?
  billingCity     String?
  billingPostcode String?
  billingIdBroj   String?
  periodFrom      DateTime
  periodTo        DateTime
  issuedAt        DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELED
}

model GuestLink {
  id         String          @id @default(cuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  token      String          @unique @default(cuid())
  guestName  String?
  // Hotel room link (QR on the room door/desk); null for regular guest links
  roomNumber String?
  checkIn    DateTime?
  checkOut   DateTime?
  viewCount  Int             @default(0)
  views      GuestLinkView[]
  sectionOverrides RoomSectionOverride[]
  createdAt  DateTime        @default(now())
}

model GuestLinkView {
  id          String    @id @default(cuid())
  guestLinkId String
  guestLink   GuestLink @relation(fields: [guestLinkId], references: [id], onDelete: Cascade)
  viewedAt    DateTime  @default(now())

  @@index([guestLinkId])
  @@index([viewedAt])
}

// ─── Guest registration (prijava gostiju) ─────────────────────────────────────

model GuestRegistration {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  checkIn       DateTime @db.Date
  checkOut      DateTime @db.Date
  guestCount    Int
  leadGuestName String
  // AES-256-GCM encrypted JSON array of guest details (see src/lib/guest-registration.ts)
  guestsEnc     String
  createdAt     DateTime @default(now())

  @@index([propertyId, checkIn])
}

// ─── Hotel ────────────────────────────────────────────────────────────────────

model HotelService {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // "SERVICE" (extras: breakfast, late checkout, transfer) | "MENU" (room service) | "FACILITY" (spa, restaurant table)
  kind        String
  category    String?  // menu grouping, e.g. "Breakfast", "Drinks"
  name        String
  description String?
  price       Float?
  priceNote   String?  // e.g. "per person"
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([propertyId, kind])
}

model GuestRequest {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestLinkId  String?
  roomNumber   String?
  // HOUSEKEEPING | TOWELS | ISSUE | WAKEUP | OTHER | ORDER | BOOKING
  type         String
  items        Json?    // ORDER: [{ name, qty, price }]; BOOKING/SERVICE: [{ name }]
  note         String?
  scheduledFor String?  // free text from the guest ("tomorrow 7:00")
  guests       Int?
  lang         String?
  // NEW | IN_PROGRESS | DONE | DECLINED
  status       String   @default("NEW")
  // Optional, only for status updates on this request; cleared after 30 days
  guestEmail   String?
  // Last status the guest was emailed about (avoids duplicate mails)
  notifiedStatus String?
  // Short note from the reception, plus its translation into the guest's language
  staffReply   String?
  staffReplyTranslated String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId, createdAt(sort: Desc)])
}

model Announcement {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  message      String
  translations Json?     // { EN, DE, TR, IT } — filled automatically
  active       Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([propertyId, active])
}

model GuestFeedback {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestLinkId String?
  roomNumber  String?
  rating      Int      // 1–5
  comment     String?
  createdAt   DateTime @default(now())

  @@index([propertyId, createdAt(sort: Desc)])
}

// ─── Onboarding follow-up emails (sent once per address) ──────────────────────

model OnboardingEmail {
  id     String   @id @default(cuid())
  email  String   @unique
  kind   String   // "user" (has account) | "lead" (left email, no account)
  sentAt DateTime @default(now())
}

// ─── Team Channel ─────────────────────────────────────────────────────────────

model Task {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation("TaskAuthor", fields: [authorId], references: [id])
  propertyId  String?
  property    Property?     @relation(fields: [propertyId], references: [id])
  content     String
  status      TaskStatus    @default(IN_PROGRESS)
  mentionIds  String[]
  comments    TaskComment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId, createdAt(sort: Desc)])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

enum TaskStatus {
  IN_PROGRESS
  DONE
}
